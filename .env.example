# Sao chép thành .env (không commit) rồi tuỳ ý đổi giá trị. Đây chỉ là DB dev cục bộ chứa dữ liệu
# ứng viên mock công khai — không có thông tin nhạy cảm, nhưng vẫn tách khỏi source theo quy định.
POSTGRES_USER=icpc
POSTGRES_PASSWORD=icpc_local_dev
POSTGRES_DB=icpc_squad_finder
POSTGRES_PORT=5432

# Backend đọc biến này để kết nối Postgres (xem source/backend/.env.example).
DATABASE_URL=postgres://icpc:icpc_local_dev@localhost:5432/icpc_squad_finder
